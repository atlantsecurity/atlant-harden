<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Redirect intermediate build output to avoid OneDrive/long path issues -->
    <BaseIntermediateOutputPath>C:\Temp\AtlantBuild\obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
    <ApplicationIcon>Resources\atlant.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AtlantHarden</AssemblyName>
    <RootNamespace>AtlantHarden</RootNamespace>
    <StartupObject>AtlantHarden.App</StartupObject>
    <Company>Atlant Security LTD</Company>
    <Product>AtlantHarden — Windows Security Hardening Tool</Product>
    <Description>Professional Windows 10/11 Security Hardening Application by Atlant Security LTD</Description>
    <Copyright>Copyright © Atlant Security LTD $([System.DateTime]::Now.Year). All rights reserved.</Copyright>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\atlant_icon.png" />
    <None Include="Resources\atlant.ico" />
    <None Include="Resources\shield.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- DISA STIG catalog (generated by tools/Generate-StigCatalog.ps1) loaded at runtime -->
    <EmbeddedResource Include="Resources\stig-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
