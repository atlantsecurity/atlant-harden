<Application x:Class="AtlantHarden.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AtlantHarden.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <conv:StringToTagConverter x:Key="StringToTagConverter"/>
            <conv:FileSizeConverter x:Key="FileSizeConverter"/>
            <conv:DateTimeConverter x:Key="DateTimeConverter"/>
            <conv:RiskLevelToBrushConverter x:Key="RiskLevelToBrushConverter"/>
            <conv:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
            <conv:StatusToEnabledConverter x:Key="StatusToEnabledConverter"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
