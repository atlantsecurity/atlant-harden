<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AtlantHarden Brand Colors -->
    <Color x:Key="PrimaryBlueColor">#0047FF</Color>
    <Color x:Key="PrimaryBlueLightColor">#3369FF</Color>
    <Color x:Key="PrimaryBlueDarkColor">#0033CC</Color>
    
    <!-- Background Colors -->
    <Color x:Key="BackgroundDarkColor">#0D1117</Color>
    <Color x:Key="BackgroundMediumColor">#161B22</Color>
    <Color x:Key="BackgroundLightColor">#21262D</Color>
    <Color x:Key="BackgroundCardColor">#1C2128</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#8B949E</Color>
    <Color x:Key="TextMutedColor">#6E7681</Color>
    
    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#238636</Color>
    <Color x:Key="SuccessLightColor">#2EA043</Color>
    <Color x:Key="WarningColor">#D29922</Color>
    <Color x:Key="WarningLightColor">#E3B341</Color>
    <Color x:Key="DangerColor">#DA3633</Color>
    <Color x:Key="DangerLightColor">#F85149</Color>
    <Color x:Key="InfoColor">#58A6FF</Color>
    
    <!-- Border Colors -->
    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="BorderLightColor">#484F58</Color>
    
    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueLightBrush" Color="{StaticResource PrimaryBlueLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueDarkBrush" Color="{StaticResource PrimaryBlueDarkColor}"/>
    
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMediumColor}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{StaticResource BackgroundCardColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    
</ResourceDictionary>
