<Window x:Class="AtlantHarden.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AtlantHarden.ViewModels"
        xmlns:local="clr-namespace:AtlantHarden.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="AtlantHarden - Windows Hardening Tool"
        Height="820" Width="1280"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}"
        KeyDown="Window_KeyDown">
    

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ScoreToColorConverter x:Key="ScoreToColorConverter"/>
        
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0066FF" Offset="0"/>
            <GradientStop Color="#00AAFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#238636" Offset="0"/>
            <GradientStop Color="#2EA043" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D29922" Offset="0"/>
            <GradientStop Color="#E3B341" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DA3633" Offset="0"/>
            <GradientStop Color="#F85149" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BackgroundDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section + collapse toggle -->
                <Border Grid.Row="0" Padding="12,16,12,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Full logo (hidden in rail mode) -->
                            <Button Grid.Column="0" Command="{Binding OpenAtlantSecurityCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" Padding="4,0,0,0"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                                <Image Source="/Resources/logo.png" Height="28"/>
                            </Button>
                            <!-- Collapse / expand toggle (always visible) -->
                            <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                                    Style="{StaticResource NavButtonStyle}"
                                    Padding="8" HorizontalAlignment="Right"
                                    ToolTip="Collapse / expand sidebar">
                                <TextBlock Text="☰" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                        <Border Background="#1A3D5A" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="4,8,0,0"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding VersionInfo}" FontSize="10" Foreground="{DynamicResource InfoBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Main Navigation -->
                <StackPanel Grid.Row="1" Margin="8,0">
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ShowDashboardCommand}" Padding="12,10" ToolTip="Dashboard">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📊" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" FontWeight="SemiBold"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ShowAllSettingsCommand}" Padding="12,10" ToolTip="All Settings">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚡" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="All Settings"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ShowBackupsCommand}" Padding="12,10" ToolTip="Backup &amp; Restore">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💾" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="Backup &amp; Restore"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Category List -->
                <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0">
                        <ItemsControl ItemsSource="{Binding CategoriesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,8" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <Border Grid.Column="2" CornerRadius="10" Padding="6,2"
                                                    Background="{DynamicResource BackgroundLightBrush}"
                                                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SettingsCount}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <!-- Section headers: "Hardening Categories" / "DISA STIG Compliance" -->
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BorderLightBrush}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Margin="12,12,0,6"
                                                       Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom -->
                <StackPanel Grid.Row="3" Margin="8,8,8,16">
                    <Separator Background="{DynamicResource BackgroundLightBrush}" Margin="4,0,4,8"/>
                    
                    <!-- Configuration Import/Export -->
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ImportConfigurationCommand}" Padding="12,8" ToolTip="Import Config">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📥" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="Import Config" FontSize="12"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ExportConfigurationCommand}" Padding="12,8" ToolTip="Export Config">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📤" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="Export Config" FontSize="12"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>

                    <Separator Background="{DynamicResource BackgroundLightBrush}" Margin="4,8,4,8"/>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ShowAboutCommand}" Padding="12,8" ToolTip="About">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ℹ️" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="About" FontSize="12"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundMediumBrush}">
            
            <!-- Dashboard View -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <StackPanel Margin="24,20">
                    <!-- Header -->
                    <TextBlock Text="Security Dashboard" FontSize="26" FontWeight="Bold" 
                               Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Monitor and improve your Windows security posture" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                    <!-- Security Score Card -->
                    <Border CornerRadius="12" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                <GradientStop Color="#1A3D5A" Offset="0"/>
                                <GradientStop Color="#0D2137" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Score Circle -->
                            <Grid Width="120" Height="120">
                                <Ellipse Stroke="{DynamicResource BackgroundLightBrush}" StrokeThickness="8" Fill="Transparent"/>
                                <Ellipse Stroke="{Binding SecurityScore, Converter={StaticResource ScoreToColorConverter}}" StrokeThickness="8" Fill="Transparent"
                                         StrokeDashArray="2.5 0.5" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SecurityScore}" FontSize="36" FontWeight="Bold" 
                                               Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="/ 100" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Score Details -->
                            <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                                <TextBlock Text="Security Score" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="{Binding SecurityLevel}" FontSize="14" 
                                           Foreground="{Binding SecurityScore, Converter={StaticResource ScoreToColorConverter}}" Margin="0,4,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="18">
                                    <Run Text="{Binding ScoreAppliedCount, Mode=OneWay}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding ScoreTotalCount, Mode=OneWay}"/>
                                    <Run Text=" Recommended protections are on. The score measures the Recommended profile only."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                           ToolTip="Strict lockdowns from the Maximum profile. They add friction and can break apps, so they don't count toward your score.">
                                    <Run Text="Optional extra lockdown (Maximum only): "/>
                                    <Run Text="{Binding ExtraLockdownAppliedCount, Mode=OneWay}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding ExtraLockdownTotalCount, Mode=OneWay}"/>
                                    <Run Text=" — not needed for a full score."/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Quick Action -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding ApplyRecommendedCommand}"
                                        Padding="20,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding QuickActionButtonIcon}" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding QuickActionButtonText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowRecommendedCommand}"
                                        Padding="20,8" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Show Recommended" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DISA STIG Compliance Card (click → all STIG settings) -->
                    <Border CornerRadius="12" Margin="0,0,0,16" Cursor="Hand" ToolTip="View all DISA STIG settings">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowComplianceCommand}" CommandParameter="Stig"/>
                        </Border.InputBindings>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                <GradientStop Color="#1A2D4A" Offset="0"/>
                                <GradientStop Color="#0D1A2F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- STIG Score Circle -->
                            <Grid Width="80" Height="80">
                                <Ellipse Stroke="{DynamicResource BackgroundLightBrush}" StrokeThickness="6" Fill="Transparent"/>
                                <Ellipse Stroke="{Binding STIGComplianceScore, Converter={StaticResource ScoreToColorConverter}}" StrokeThickness="6" Fill="Transparent"
                                         StrokeDashArray="2.5 0.5" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding STIGComplianceScore}" FontSize="24" FontWeight="Bold" 
                                               Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- STIG Details -->
                            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏛️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DISA STIG Compliance" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding STIGComplianceLevel}" FontSize="13" 
                                           Foreground="{Binding STIGComplianceScore, Converter={StaticResource ScoreToColorConverter}}" Margin="0,4,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" LineHeight="16">
                                    <Run Text="{Binding AppliedSTIGCount, Mode=OneWay}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding STIGSettingsCount, Mode=OneWay}"/>
                                    <Run Text=" DoD STIG requirements applied"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Per-product STIG breakdown -->
                            <Border Grid.Column="2" CornerRadius="8" Background="#1A0066CC" Padding="14,10" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding StigProductSummaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" MinWidth="190">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InfoBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StigVersion}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Progress}" FontSize="10" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ACSC Compliance Card (click → Essential Eight settings) -->
                    <Border CornerRadius="12" Margin="0,0,0,16" Cursor="Hand" ToolTip="View the ACSC Essential Eight settings">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowComplianceCommand}" CommandParameter="Acsc"/>
                        </Border.InputBindings>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                <GradientStop Color="#1A2D3A" Offset="0"/>
                                <GradientStop Color="#0D1A25" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- ACSC Score Circle -->
                            <Grid Width="80" Height="80">
                                <Ellipse Stroke="{DynamicResource BackgroundLightBrush}" StrokeThickness="6" Fill="Transparent"/>
                                <Ellipse Stroke="{Binding ACSCComplianceScore, Converter={StaticResource ScoreToColorConverter}}" StrokeThickness="6" Fill="Transparent"
                                         StrokeDashArray="2.5 0.5" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ACSCComplianceScore}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ACSC Details -->
                            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🇦🇺" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ACSC Essential Eight" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ACSCComplianceLevel}" FontSize="13"
                                           Foreground="{Binding ACSCComplianceScore, Converter={StaticResource ScoreToColorConverter}}" Margin="0,4,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" LineHeight="16">
                                    <Run Text="{Binding AppliedACSCCount, Mode=OneWay}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding ACSCSettingsCount, Mode=OneWay}"/>
                                    <Run Text=" ACSC requirements applied"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- ACSC Info -->
                            <Border Grid.Column="2" CornerRadius="8" Background="#1A00CC66" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Essential Eight" FontSize="11" FontWeight="SemiBold" Foreground="#00CC66"/>
                                    <TextBlock Text="July 2024" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Quick Profiles -->
                    <TextBlock Text="Quick Hardening Profiles" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,12"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Basic Profile -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SuccessBadgeBrush}" Margin="0,0,0,12">
                                    <TextBlock Text="🛡️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Basic" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="Highest-ROI core, zero friction" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding BasicProfileCount, StringFormat='{}{0} settings'}" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="{Binding BasicAppliedCount, Mode=OneWay}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold"/><Run Text=" of " Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text="{Binding BasicProfileCount, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text=" already applied  ·  " Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text="{Binding BasicRemainingCount, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/><Run Text=" to go" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Apply"
                                        Command="{Binding ApplyBasicProfileCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,8"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Show settings"
                                        Command="{Binding ShowProfileCommand}" CommandParameter="Basic"
                                        HorizontalAlignment="Stretch" Padding="0,7" Margin="0,6,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Recommended Profile -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0" Padding="16"
                                BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                            <StackPanel>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource InfoBadgeBrush}" Margin="0,0,0,12">
                                    <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Recommended" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="BEST" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Stops real malware &amp; exploits — no crippling" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding RecommendedProfileCount, StringFormat='{}{0} settings'}" FontSize="11" Foreground="{DynamicResource InfoBrush}"/>
                                    <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="{Binding RecommendedAppliedCount, Mode=OneWay}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold"/><Run Text=" of " Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text="{Binding RecommendedProfileCount, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text=" already applied  ·  " Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text="{Binding RecommendedRemainingCount, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/><Run Text=" to go" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource SuccessButtonStyle}" Content="Apply"
                                        Command="{Binding ApplyRecommendedCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,8"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Show settings"
                                        Command="{Binding ShowProfileCommand}" CommandParameter="Recommended"
                                        HorizontalAlignment="Stretch" Padding="0,7" Margin="0,6,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Maximum Profile -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0" Padding="16">
                            <StackPanel>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource WarningBadgeBrush}" Margin="0,0,0,12">
                                    <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Maximum" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="Everything, incl. STIG lockdowns (friction)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding MaximumProfileCount, StringFormat='{}{0} settings'}" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="{Binding MaximumAppliedCount, Mode=OneWay}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold"/><Run Text=" of " Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text="{Binding MaximumProfileCount, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text=" already applied  ·  " Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text="{Binding MaximumRemainingCount, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/><Run Text=" to go" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Apply"
                                        Command="{Binding ApplyMaximumProfileCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,8"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Show settings"
                                        Command="{Binding ShowProfileCommand}" CommandParameter="Maximum"
                                        HorizontalAlignment="Stretch" Padding="0,7" Margin="0,6,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- Cleanup & Privacy quick actions -->
                    <TextBlock Text="Cleanup &amp; Privacy" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadingBrush}" Margin="0,20,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tighten Up Privacy -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,4,0" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#1A8764B8" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="👁️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tighten Up Privacy" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock Text="Turn off telemetry, ad ID, activity history &amp; suggested content" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Apply"
                                        Command="{Binding TightenPrivacyCommand}"
                                        VerticalAlignment="Center" Padding="18,8" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Clean Up Bloat -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,0,0" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#1A68768A" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🗑️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Clean Up Bloat" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock Text="Remove Store junk, games &amp; OEM/AV trials (McAfee, Norton…)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Review"
                                        Command="{Binding CleanUpBloatCommand}"
                                        VerticalAlignment="Center" Padding="18,8" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Category Overview -->
                    <TextBlock Text="Category Overview" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadingBrush}" Margin="0,20,0,12"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextHeadingBrush}" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,6,0,0">
                                                <ProgressBar Value="{Binding EnabledCount}" Maximum="{Binding SettingsCount}"
                                                             Height="4" Background="{DynamicResource BackgroundLightBrush}" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Grid>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding EnabledCount, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding SettingsCount, Mode=OneWay}"/>
                                                <Run Text=" applied"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Export Report Button -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="📄 Export Security Report" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="Generate a detailed HTML report of your current security configuration" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding ExportReportCommand}"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Export Report"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings View -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource BackgroundDarkBrush}" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedCategory.Name}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingAllSettings}" Value="True">
                                                <Setter Property="Text" Value="All Security Settings"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShowingRecommended}" Value="True">
                                                <Setter Property="Text" Value="Recommended Settings"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShowingBasic}" Value="True">
                                                <Setter Property="Text" Value="Basic Settings"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="4">
                                                <Setter Property="Text" Value="DISA STIG Settings"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="5">
                                                <Setter Property="Text" Value="ACSC Essential Eight"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedCategory.Description}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingAllSettings}" Value="True">
                                                <Setter Property="Text" Value="Browse and configure all available security hardening options"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShowingRecommended}" Value="True">
                                                <Setter Property="Text" Value="High-ROI, low-friction protection — review each, then toggle and Apply Selected"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShowingBasic}" Value="True">
                                                <Setter Property="Text" Value="The highest-impact, zero-friction core — review each, then toggle and Apply Selected"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="4">
                                                <Setter Property="Text" Value="Every automatable DISA STIG requirement — not-yet-applied first; review, then Apply Selected"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="5">
                                                <Setter Property="Text" Value="The ACSC Essential Eight (July 2024) — not-yet-applied first; review, then Apply Selected"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" Margin="0,0,10,0"
                                    Command="{Binding ShowPendingChangesCommand}"
                                    ToolTip="Show only the settings that Apply Selected will change"
                                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="{DynamicResource InfoBrush}">
                                    <Run Text="● "/><Run Text="{Binding PendingChangesCount, Mode=OneWay}"/><Run Text=" pending changes"/>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Select All" Padding="14,8" FontSize="12"
                                    Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Deselect" Padding="14,8" FontSize="12"
                                    Command="{Binding DeselectAllCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource SuccessButtonStyle}" Padding="16,8" FontSize="12"
                                    Command="{Binding ApplySelectedCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                    <TextBlock Text="Apply Selected"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filters Bar -->
                <Border Grid.Row="1" Background="{DynamicResource BackgroundMediumBrush}" Padding="20,10" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search (flexible width, shrinks on small screens) -->
                        <Border Grid.Column="0" Background="{DynamicResource BackgroundDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" MinWidth="120" MaxWidth="380"
                                HorizontalAlignment="Left" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.6"/>
                                <TextBox Grid.Column="1"
                                         AutomationProperties.Name="Search settings"
                                         ToolTip="Search by name, description, registry value, STIG ID (e.g. WN11-SO-000195), Vuln ID or CCI"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextHeadingBrush}" CaretBrush="{DynamicResource TextHeadingBrush}"
                                         FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Risk / STIG Filter -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding SelectedStatusFilter}" Width="140" FontSize="12" Margin="0,0,12,0"
                                      AutomationProperties.Name="Status filter">
                                <ComboBoxItem Content="Any status"/>
                                <ComboBoxItem Content="Not applied"/>
                                <ComboBoxItem Content="Applied"/>
                                <ComboBoxItem Content="Can't verify"/>
                                <ComboBoxItem Content="Pending changes"/>
                            </ComboBox>
                            <TextBlock Text="Risk / framework:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding SelectedRiskFilter}" Width="170" FontSize="12"
                                      AutomationProperties.Name="Risk or framework filter">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Low Risk"/>
                                <ComboBoxItem Content="Medium Risk"/>
                                <ComboBoxItem Content="High Risk"/>
                                <ComboBoxItem Content="STIG Only"/>
                                <ComboBoxItem Content="ACSC Only"/>
                                <ComboBoxItem Content="STIG: CAT I (High)"/>
                                <ComboBoxItem Content="STIG: CAT II (Medium)"/>
                                <ComboBoxItem Content="STIG: CAT III (Low)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings List (Virtualized) -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding CurrentSettings}"
                         Background="Transparent" BorderThickness="0"
                         Padding="16,12"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" Margin="0,0,0,6" Padding="14"
                                        BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Toggle -->
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled}"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  AutomationProperties.HelpText="{Binding StatusText}"
                                                  ToolTip="On = keep/apply this setting. Off on an applied setting = revert it on Apply."
                                                  VerticalAlignment="Top" Margin="0,2,14,0"/>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                
                                                <!-- Risk Badge -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,0,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBadgeBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningBadgeBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Risk}" Value="High">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerBadgeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RiskDisplay}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Risk}" Value="High">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Status: Applied / Not applied / Can't verify -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="Applied">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBadgeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="Applied">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Pending change: what Apply Selected will do with this row -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,2"
                                                        Visibility="{Binding HasPendingChange, Converter={StaticResource BoolToVis}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource InfoBadgeBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PendingState}" Value="Will revert">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningBadgeBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingState}" Value="Will remove">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerBadgeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PendingState}" Value="Will revert">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PendingState}" Value="Will remove">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerLightBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="● "/><Run Text="{Binding PendingState, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Category -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,2" Background="{DynamicResource BackgroundLightBrush}">
                                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>

                                                <!-- Needs restart -->
                                                <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,2" Background="{DynamicResource BackgroundLightBrush}"
                                                        Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="↻ Needs restart" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>

                                            <!-- Warning -->
                                            <Border Visibility="{Binding ImpactWarning, Converter={StaticResource NullToVisibilityConverter}}"
                                                    Background="{DynamicResource WarningBadgeBrush}" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚠️" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ImpactWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- What it changes (any setting type), with copy -->
                                            <Border Background="{DynamicResource BackgroundMediumBrush}" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ChangeSummary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                               FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Copy" FontSize="10" Padding="6,1" Margin="8,0,0,0"
                                                            Background="Transparent" Foreground="{DynamicResource InfoBrush}" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Copy to clipboard" AutomationProperties.Name="Copy change details"
                                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ChangeSummary}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Details (collapsed by default so the list stays scannable) -->
                                            <Expander Header="Details" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"
                                                      Visibility="{Binding DetailedInfo, Converter={StaticResource NullToVisibilityConverter}}">
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding DetailedInfo}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                                               TextWrapping="Wrap" FontStyle="Italic"/>
                                                    <ItemsControl ItemsSource="{Binding ReferenceUrls}" Margin="0,4,0,0"
                                                                  Visibility="{Binding HasReferences, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1"
                                                                        Cursor="Hand" HorizontalAlignment="Left" ToolTip="Open in your browser"
                                                                        Command="{Binding DataContext.OpenReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Foreground="{DynamicResource InfoBrush}" FontSize="10" TextDecorations="Underline" TextWrapping="Wrap">
                                                                        <Run Text="📎 "/><Run Text="{Binding Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>

                                        <!-- Current Value -->
                                        <StackPanel Grid.Column="2" MinWidth="120" Margin="14,0,0,0">
                                            <TextBlock Text="Current" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CurrentValueDisplay}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CurrentValueDisplay}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                            <TextBlock Text="Recommended" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding RecommendedDisplay}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RecommendedDisplay}"
                                                       FontSize="12" Foreground="{DynamicResource InfoBrush}" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status Bar -->
                <Border Grid.Row="3" Background="{DynamicResource BackgroundDarkBrush}" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>

                        <ProgressBar Grid.Column="1" Width="150" Height="4" Margin="16,0"
                                     Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                     Background="{DynamicResource BackgroundLightBrush}" Foreground="{DynamicResource SuccessBrush}"
                                     Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="{Binding CurrentSettings.Count, Mode=OneWay}"/>
                            <Run Text=" settings"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- Backups View -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Backups">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <StackPanel Margin="24,20">
                    <TextBlock Text="Backup &amp; Restore" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Protect your system with restore points and registry backups" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                    <!-- System Restore Section -->
                    <TextBlock Text="🔄 Windows System Restore" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,12"/>
                    
                    <!-- Create System Restore Point -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SuccessBadgeBrush}" Margin="0,0,14,0">
                                <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Create Restore Point" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="Creates a Windows System Restore point before making changes" 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SuccessButtonStyle}" 
                                    Command="{Binding CreateRestorePointCommand}" Padding="14,8">
                                <TextBlock Text="Create"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Open System Restore Dialog -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InfoBadgeBrush}" Margin="0,0,14,0">
                                <TextBlock Text="⏪" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Restore from System Restore Point" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="Opens Windows System Restore to recover your entire system" 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding OpenSystemRestoreCommand}" Padding="14,8">
                                <TextBlock Text="Open System Restore"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Registry Backups Section -->
                    <TextBlock Text="💾 Registry Backups" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,12"/>
                    
                    <!-- Info -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="18">
                                Registry backups are created automatically before applying settings. Each backup includes:
                            </TextBlock>
                            <StackPanel Margin="12,8,0,0">
                                <TextBlock Text="• .ashb file - Full backup data for app restore" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="• restore_*.reg - Reverts to original values (double-click to apply)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="• applied_*.reg - Shows what settings were applied (reference)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="📂 Open Backup Folder" 
                                    Command="{Binding OpenBackupFolderCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" Padding="32"
                            Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No backups yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Backups are created automatically when you apply settings" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup Items -->
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" 
                                        Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource InfoBadgeBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}">
                                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}'}"/>
                                                <Run Text=" at " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:h:mm tt}'}"/>
                                            </TextBlock>
                                            <Border CornerRadius="4" Padding="6,1" Margin="0,3,0,3" Background="{DynamicResource SuccessBadgeBrush}" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsBaseline, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="The first backup taken on this PC — its original state. Never deleted automatically.">
                                                <TextBlock Text="★ Original state (baseline)" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}"/>
                                            </Border>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding Description, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource SuccessButtonStyle}"
                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="12,8" FontSize="12">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Restore"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="10,8" Margin="6,0,0,0" FontSize="12">
                                                <TextBlock Text="🗑️"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- About View -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="About">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <StackPanel Margin="24,20" MaxWidth="650" HorizontalAlignment="Center">
                    <Button Command="{Binding OpenAtlantSecurityCommand}" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Center" Padding="0" Margin="0,0,0,16">
                        <Image Source="/Resources/logo.png" Height="50"/>
                    </Button>
                    <TextBlock Text="Windows 10 &amp; 11 Security Hardening" FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding VersionInfo}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,4,0,4"/>
                    <TextBlock Text="{Binding BuildInfo}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding PerUserTargetText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>

                    <!-- CRITICAL BACKUP WARNING -->
                    <Border Background="#1AD92E2E" BorderBrush="{DynamicResource AlertRedBrush}" BorderThickness="1" 
                            CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🔴" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Critical: Backup Your System" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AlertRedBrush}"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextHeadingBrush}" FontSize="13" LineHeight="22">
                                Always use the Backup section to create a System Restore Point before running this application or changing any settings. Do not rely on the app to create your backups for you! A manual System Restore Point gives you the best protection against any issues.
                            </TextBlock>
                            <Button Command="{Binding OpenSystemRestoreCommand}" 
                                    Content="Open System Restore" 
                                    Background="{DynamicResource AlertRedBrush}" Foreground="White" 
                                    BorderThickness="0" Padding="16,8" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Disclaimer -->
                    <Border Background="{DynamicResource WarningBadgeBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" 
                            CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Important Disclaimer" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextHeadingBrush}" FontSize="13" LineHeight="20">
                                AtlantHarden provides this Windows 11 hardening application as-is. Always take a full backup of your registry before running it, regardless of the backup/recovery options in the application. Enabling all security settings will significantly change the behavior of your system - do your own research and enable settings at your own risk. AtlantHarden is not responsible for your choices.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Features" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="🛡️ Windows Defender" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="🎯 Attack Surface Reduction" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="🔐 Credential Protection" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="🌐 Browser Hardening" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="📋 Logging &amp; Auditing" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="🔒 TLS &amp; Cryptography" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="💾 Automatic Backups" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="🔄 System Restore Points" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- License -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource BackgroundLightBrush}" BorderThickness="1" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="License" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="20">
                                AtlantHarden is <Run FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}">free to use</Run> — including on your own or your organization's systems — as long as you don't charge for its use. Using it as a paid product or service, or to secure clients' systems for a fee, requires a commercial licensing agreement with <Run FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}">Atlant Security LTD</Run>.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,10,0,0">
                                The source code is published separately for audit only, under a different license that grants no right to use the source. See the LICENSE file in the repository.
                            </TextBlock>
                            <Button Command="{Binding OpenLicenseContactCommand}"
                                    Content="Request a commercial license"
                                    Background="{DynamicResource SuccessBrush}" Foreground="White"
                                    BorderThickness="0" Padding="16,8" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CopyrightText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,4"/>
                    <Button Command="{Binding OpenAtlantSecurityCommand}" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Center" Padding="0">
                        <TextBlock Text="https://atlantsecurity.com" FontSize="11" Foreground="{DynamicResource InfoBrush}" 
                                   TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Processing Overlay -->
            <Border Background="#CC000000" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource BackgroundLightBrush}" Margin="0,0,0,16">
                        <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="16" Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ProgressBar Width="260" Height="4" Background="{DynamicResource BackgroundLightBrush}" Foreground="{DynamicResource SuccessBrush}"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Button Content="Cancel" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="16,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Stop after the current setting. Changes already made stay, and the backup can undo them."
                            Command="{Binding CancelOperationCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
